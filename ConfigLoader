package Ex05;
import java.io.IOException;
public class ConfigLoader {
    public static void loadConfigFile(String filepath) throws IOException {
        if (filepath.equals("") || filepath.contains("invalid"))
        {
            throw new IOException("Không tìm thấy tệp cấu hình tại đường dẫn: " + filepath);
        }
        System.out.println("-> Nạp cấu hình thành công từ: " + filepath);
    }
}
